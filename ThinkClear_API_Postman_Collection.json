								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('bearer_token', jsonData.data.access_token);",
									"        console.log('Bearer token saved:', jsonData.data.access_token);",
