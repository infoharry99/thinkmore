						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"case_id\": \"P1-002\",\n  \"domain\": \"Career\",\n  \"phase_target\": 1,\n  \"trap_target\": [\n    \"Catastrophizing\"\n  ],\n  \"opening_scenario\": \"Your manager sends a calendar invite titled 'Quick Sync' with no agenda for tomorrow morning.\",\n  \"step1_detect\": {\n    \"fact\": \"Manager sent a calendar invite with no agenda.\",\n    \"story\": \"I am going to get fired tomorrow.\"\n  },\n  \"step2_decode\": {\n    \"trap\": \"Catastrophizing\",\n    \"explanation\": \"Assuming the absolute worst outcome with zero evidence.\"\n  },\n  \"step5_intervention\": {\n    \"action\": \"Reply politely asking if there is anything specific you should prepare for the meeting.\"\n  },\n  \"step6_internalize\": {\n    \"principle\": \"No agenda is a lack of detail, not a death sentence.\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/cases",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"admin",
