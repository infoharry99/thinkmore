{
	"info": {
		"_postman_id": "thinkclear-api-collection-v1",
		"name": "ThinkClear REST API Collection",
		"description": "Complete Postman collection for ThinkClear mobile application REST APIs and Admin endpoints, including Sanctum Bearer token auto-handling, Social Login (Google/Apple), and OTP Password Reset.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('bearer_token', jsonData.data.access_token);",
									"        console.log('Bearer token saved:', jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Student User\",\n  \"email\": \"student@thinkclear.co.in\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"register"
							]
						},
						"description": "Registers a new student user and saves the bearer_token automatically."
					},
					"response": []
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('bearer_token', jsonData.data.access_token);",
									"        console.log('Bearer token saved:', jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"arun@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Logs in user and auto-saves the Sanctum bearer token."
					},
					"response": []
				},
				{
					"name": "Social Login (Google / Apple)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('bearer_token', jsonData.data.access_token);",
									"        console.log('Bearer token saved:', jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"provider\": \"google\",\n  \"provider_id\": \"109876543210987654321\",\n  \"email\": \"social.user@gmail.com\",\n  \"name\": \"Social User\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/social-login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"social-login"
							]
						},
						"description": "Authenticates via Google or Apple OAuth ID and returns Sanctum Bearer Token."
					},
					"response": []
				},
				{
					"name": "Forgot Password (Request OTP)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"arun@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/forgot-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"forgot-password"
							]
						},
						"description": "Generates 6-digit OTP code for password reset."
					},
					"response": []
				},
				{
					"name": "Reset Password (Using OTP)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"arun@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"newpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/reset-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"reset-password"
							]
						},
						"description": "Resets user password using email, 6-digit OTP, and new password."
					},
					"response": []
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"user",
								"profile"
							]
						},
						"description": "Returns current user details, day progress (1-60), and active phase."
					},
					"response": []
				},
				{
					"name": "Logout User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"logout"
							]
						},
						"description": "Revokes current access token."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Case Engine & Daily Practice",
			"item": [
				{
					"name": "Get Today's Case Scenario",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases/today",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"cases",
								"today"
							]
						},
						"description": "Retrieves the active scenario for the user's current day based on Phase 0-3 scaffolding."
					},
					"response": []
				},
				{
					"name": "Submit Reflection",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"case_id\": 1,\n  \"internalize_text\": \"Silence is not a message. It's a blank I fill in — check before I fill it with the worst option.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cases/submit-reflection",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"cases",
								"submit-reflection"
							]
						},
						"description": "Stores the user's 1-line INTERNALIZE principle (Minimal Retention Rule) and increments day progress."
					},
					"response": []
				}
			]
		},
		{
